---
import Base from './Base.astro';
interface Props { title: string; description: string; noindex?: boolean }
const { title, description, noindex } = Astro.props;
---
<Base title={title} description={description} noindex={noindex}>
  <div class="wrap">
    <h1>{title}</h1>
    <div class="prose"><slot /></div>
  </div>
</Base>
<style>
  h1 { font-size: clamp(2.4rem, 6vw, 4rem); font-weight: 800; letter-spacing: -0.04em; margin: 56px 0 24px; max-width: 18ch; }
</style>
