---
import { getCollection, getEntries, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import ToolGrid from '../components/ToolGrid.astro';
import ToolFilter from '../components/ToolFilter.astro';
import CompareCards from '../components/CompareCards.astro';
import CompareTable from '../components/CompareTable.astro';
import Monogram from '../components/Monogram.astro';
import { getArticles, getPickedToolIds, CATEGORIES, articleUrl, type Category } from '../lib/site';
import { SITE } from '../site.config.mjs';

const tools = await getCollection('tools');
const articles = await getArticles();
const picked = await getPickedToolIds();
const counts = Object.fromEntries(Object.keys(CATEGORIES).map((c) => [c, tools.filter((t) => t.data.category === c).length]));

// Show editor's picks first, then the rest, so the grid opens with the strongest tools.
const ordered = [...tools].sort((a, b) => Number(picked.has(b.id)) - Number(picked.has(a.id)));

const flagship = articles.find((a) => a.id === 'chatgpt-vs-claude-vs-gemini');
const flagshipTools = flagship ? await getEntries(flagship.data.tools) : [];

// "Top picks" boards: the use-case picks from the newest comparison in each category.
const boards = await Promise.all(
  (Object.keys(CATEGORIES) as Category[]).map(async (c) => {
    const a = articles.find((x) => x.data.category === c);
    if (!a) return null;
    const seen = new Set<string>();
    const unique = a.data.picks.filter((p) => !seen.has(p.tool.id) && seen.add(p.tool.id));
    const rows = await Promise.all(unique.map(async (p) => ({ useCase: p.useCase, tool: (await getEntry(p.tool))! })));
    return { c, a, rows };
  })
);
---
<Base title={SITE.name} description={SITE.description}>
  <section class="hero">
    <div class="wrap inner">
      <h1>Find the best <span>AI tools</span> for every job</h1>
      <p class="intro">Compare features and pricing of {tools.length} leading AI tools, with side-by-side comparisons that name a clear pick for every use case.</p>
      <ToolFilter counts={counts} hero />
      <div class="ctas">
        <a class="btn btn-primary" href="/tools/">Explore tools</a>
        <a class="btn btn-ghost" href="/compare/">Compare tools</a>
      </div>
    </div>
  </section>

  <div class="wrap">
    <ToolGrid tools={ordered} picks={picked} />

    {flagship && (
      <section aria-labelledby="h2h">
        <div class="section-head">
          <h2 id="h2h" class="section-h">ChatGPT vs Claude vs Gemini at a glance</h2>
          <a href={articleUrl(flagship)}>Read the full comparison</a>
        </div>
        <div class="panel">
          <CompareTable tools={flagshipTools} comparison={flagship.data.comparison} heading={false} />
        </div>
      </section>
    )}

    <section aria-labelledby="picks-h">
      <h2 id="picks-h" class="section-h">Top picks by category</h2>
      <div class="boards">
        {boards.filter(Boolean).map((b) => (
          <article class="board">
            <h3><a href={`/category/${b!.c}/`}>{CATEGORIES[b!.c].label}</a></h3>
            <ol>
              {b!.rows.map((r) => (
                <li>
                  <Monogram name={r.tool.data.name} color={r.tool.data.color} size={28} />
                  <a href={`/tools/${r.tool.id}/`}>{r.tool.data.name}</a>
                  <span>{r.useCase}</span>
                </li>
              ))}
            </ol>
            <a class="more" href={articleUrl(b!.a)}>See why</a>
          </article>
        ))}
      </div>
    </section>

    <section aria-labelledby="latest-h">
      <div class="section-head">
        <h2 id="latest-h" class="section-h">Latest comparisons</h2>
        <a href="/compare/">All comparisons</a>
      </div>
      <CompareCards articles={articles.slice(0, 6)} />
    </section>

    <section aria-labelledby="cats-h">
      <div class="section-head">
        <h2 id="cats-h" class="section-h">Browse by category</h2>
        <a href="/categories/">All categories</a>
      </div>
      <ul class="cats" role="list">
        {Object.entries(CATEGORIES).map(([id, c]) => (
          <li><a href={`/category/${id}/`}>{c.label}</a><span>{counts[id]} tools</span></li>
        ))}
      </ul>
    </section>
  </div>
</Base>
<style>
  .hero {
    background:
      radial-gradient(60% 70% at 50% 0%, var(--hero-glow), transparent 70%),
      linear-gradient(var(--paper-raised), var(--paper));
    border-bottom: 1px solid var(--rule);
    padding-block: clamp(56px, 9vw, 112px) clamp(44px, 6vw, 72px);
    margin-bottom: 48px;
  }
  .inner {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  h1 {
    font-size: clamp(2.5rem, 6.4vw, 4.6rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.03;
    max-width: 17ch;
    margin: 0;
  }
  h1 span {
    color: var(--cobalt);
  }
  .intro {
    font-size: clamp(1.05rem, 1.5vw, 1.22rem);
    max-width: 56ch;
    color: var(--ink-soft);
    margin: 22px 0 34px;
    line-height: 1.6;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 8px;
  }
  .ctas .btn {
    padding: 14px 28px;
    border-radius: 14px;
  }
  .panel {
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 14px;
    padding: 4px 8px;
    box-shadow: var(--shadow);
  }
  .boards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 16px;
  }
  .board {
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 14px;
    padding: 20px;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
  }
  .board h3 {
    margin: 0 0 12px;
    font-size: 1.1rem;
  }
  .board h3 a {
    color: var(--ink);
  }
  .board ol {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: rank;
    display: grid;
    gap: 10px;
    flex: 1;
  }
  .board li {
    display: grid;
    grid-template-columns: 22px 28px 1fr;
    grid-template-rows: auto auto;
    column-gap: 10px;
    align-items: center;
    font-family: var(--display);
    counter-increment: rank;
  }
  .board li::before {
    content: counter(rank);
    grid-row: span 2;
    font-weight: 700;
    color: var(--ink-soft);
  }
  .board li :global(.mono) {
    grid-row: span 2;
  }
  .board li a {
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
  }
  .board li a:hover {
    text-decoration: underline;
  }
  .board li span {
    font-size: 0.85rem;
    color: var(--ink-soft);
    grid-column: 3;
  }
  .more {
    margin-top: 14px;
    font-family: var(--display);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .cats {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 12px;
  }
  .cats li {
    position: relative;
    display: grid;
    gap: 2px;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 12px;
    padding: 16px 18px;
  }
  .cats li:hover {
    border-color: var(--cobalt);
  }
  .cats a {
    font-family: var(--display);
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
  }
  .cats a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .cats span {
    font-family: var(--display);
    font-size: 0.88rem;
    color: var(--ink-soft);
  }
</style>
