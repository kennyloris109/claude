---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Monogram from '../../components/Monogram.astro';
import { CATEGORIES, getArticles, type Category } from '../../lib/site';
const tools = await getCollection('tools');
const articles = await getArticles();
---
<Base title="AI tool categories" description="Browse AI tools by the job you need done: chatbots, coding, images, video, voice, AI search, meeting notes and presentations.">
  <div class="wrap">
    <h1>Categories</h1>
    <p class="lede">We group AI tools by the job you need done, so you can compare tools that solve the same problem. Each category lists every tool we cover in it and links to our side-by-side comparisons, where we name a pick for each use case and show current prices.</p>
    <ul class="grid" role="list">
      {(Object.keys(CATEGORIES) as Category[]).map((c, i) => {
        const ts = tools.filter((t) => t.data.category === c);
        const n = articles.filter((a) => a.data.category === c).length;
        return (
          <li>
            <h2><a href={`/category/${c}/`}>{CATEGORIES[c].label}</a></h2>
            <p>{CATEGORIES[c].blurb}</p>
            <div class="row" aria-hidden="true">{ts.slice(0, 5).map((t) => <Monogram name={t.data.name} color={t.data.color} size={30} eager={i < 3} />)}</div>
            <p class="names">Includes {ts.map((t) => t.data.name).join(', ')}.</p>
            <span class="count">{ts.length} tools{n ? `, ${n} comparison${n > 1 ? 's' : ''}` : ''}</span>
          </li>
        );
      })}
    </ul>
  </div>
</Base>
<style>
  h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); font-weight: 800; letter-spacing: -0.04em; margin: 48px 0 28px; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 16px; }
  li { position: relative; background: var(--paper-raised); border: 1px solid var(--rule); border-radius: 14px; padding: 20px; box-shadow: var(--shadow); display: flex; flex-direction: column; gap: 10px; }
  li:hover, li:focus-within { border-color: var(--cobalt); }
  h2 { margin: 0; font-size: 1.2rem; }
  h2 a { color: var(--ink); text-decoration: none; }
  h2 a::after { content: ''; position: absolute; inset: 0; }
  p { margin: 0; font-family: var(--display); color: var(--ink-soft); font-size: 0.95rem; line-height: 1.45; flex: 1; }
  .row { display: flex; gap: 6px; }
  .lede { font-size: 1.1rem; line-height: 1.6; color: var(--ink-soft); max-width: 62ch; margin: -12px 0 28px; }
  .names { font-size: 0.9rem; color: var(--ink); flex: 0; }
  .count { font-family: var(--display); font-size: 0.88rem; color: var(--ink-soft); }
</style>
