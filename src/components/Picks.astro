---
import { getEntry, type CollectionEntry } from 'astro:content';
import Monogram from './Monogram.astro';
interface Props { picks: CollectionEntry<'articles'>['data']['picks'] }
const rows = await Promise.all(
  Astro.props.picks.map(async (p) => ({ ...p, tool: (await getEntry(p.tool))! }))
);
---
{rows.length > 0 && (
  <section class="picks" aria-labelledby="picks-h">
    <h2 id="picks-h">Which one should you pick?</h2>
    <dl>
      {rows.map((r) => (
        <div class="row">
          <dt>{r.useCase}</dt>
          <dd>
            <span class="tool"><Monogram name={r.tool.data.name} color={r.tool.data.color} size={30} /><a href={`/tools/${r.tool.id}/`}>{r.tool.data.name}</a></span>
            <span class="why">{r.why}</span>
          </dd>
        </div>
      ))}
    </dl>
  </section>
)}
<style>
  .picks {
    margin: 48px 0;
    max-width: 860px;
  }
  h2 {
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
    margin: 0 0 16px;
  }
  dl {
    margin: 0;
    border-top: 2px solid var(--ink);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(150px, 0.8fr) 2fr;
    gap: 8px 24px;
    padding: 16px 0;
    border-bottom: 1px solid var(--rule);
  }
  dt {
    font-family: var(--display);
    font-weight: 600;
  }
  dd {
    margin: 0;
    display: grid;
    gap: 4px;
  }
  .tool {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.1rem;
  }
  .tool a {
    color: var(--ink);
  }
  .why {
    color: var(--ink-soft);
  }
  @media (max-width: 600px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
