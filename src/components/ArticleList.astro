---
import { getEntries, type CollectionEntry } from 'astro:content';
import Monogram from './Monogram.astro';
import { articleUrl, formatDate } from '../lib/site';
interface Props { articles: CollectionEntry<'articles'>[]; headingLevel?: 'h2' | 'h3' }
const { articles, headingLevel: H = 'h2' } = Astro.props;
const items = await Promise.all(articles.map(async (a) => ({ a, tools: await getEntries(a.data.tools) })));
---
<ol class="list" role="list">
  {items.map(({ a, tools }) => (
    <li>
      <div class="badges">{tools.map((t) => <Monogram name={t.data.name} color={t.data.color} size={40} />)}</div>
      <div>
        <H class="t"><a href={articleUrl(a)}>{a.data.title}</a></H>
        <p class="v">{a.data.verdict}</p>
        <p class="d">Updated <time datetime={a.data.updatedDate.toISOString()}>{formatDate(a.data.updatedDate)}</time></p>
      </div>
    </li>
  ))}
</ol>
<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--ink);
  }
  li {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 24px;
    padding: 26px 0;
    border-bottom: 1px solid var(--rule);
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-content: start;
  }
  .t {
    font-size: clamp(1.3rem, 2.2vw, 1.65rem);
    margin: 0 0 8px;
  }
  .t a {
    color: var(--ink);
    text-decoration: none;
  }
  .t a:hover {
    text-decoration: underline;
  }
  .v {
    margin: 0;
    max-width: 70ch;
    color: var(--ink-soft);
  }
  .d {
    margin: 8px 0 0;
    font-family: var(--display);
    font-size: 0.88rem;
    color: var(--ink-soft);
  }
  @media (max-width: 640px) {
    li {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>
