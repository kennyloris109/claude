---
import type { CollectionEntry } from 'astro:content';
import Monogram from './Monogram.astro';
import { CATEGORIES } from '../lib/site';
interface Props { tool: CollectionEntry<'tools'>; pick?: boolean }
const { tool, pick = false } = Astro.props;
const t = tool.data;
const tagClass = t.pricing === 'Free' ? 'tag free' : t.pricing === 'Paid' ? 'tag paid' : 'tag';
---
<li class="card" data-name={`${t.name} ${t.vendor} ${t.bestFor}`.toLowerCase()} data-category={t.category}>
  <div class="top">
    <Monogram name={t.name} color={t.color} size={44} />
    <div class="id">
      <h3><a href={`/tools/${tool.id}/`}>{t.name}</a></h3>
      <span class="cat">{CATEGORIES[t.category].label}</span>
    </div>
  </div>
  <p>{t.bestFor}</p>
  <div class="meta">
    <span class={tagClass}>{t.pricing}</span>
    {pick && <span class="tag pick">Top pick</span>}
  </div>
</li>
<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 14px;
    padding: 18px;
    box-shadow: var(--shadow);
    transition: border-color 0.15s;
  }
  .card:hover,
  .card:focus-within {
    border-color: var(--cobalt);
  }
  .top {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .id {
    display: grid;
    min-width: 0;
  }
  h3 {
    margin: 0;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
  }
  h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  /* Whole card is clickable via the title link. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 14px;
  }
  .cat {
    font-family: var(--display);
    font-size: 0.85rem;
    color: var(--ink-soft);
  }
  p {
    margin: 0;
    font-family: var(--display);
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--ink-soft);
    flex: 1;
  }
  .meta {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .pick {
    background: var(--highlight);
    color: var(--highlight-ink);
  }
</style>
