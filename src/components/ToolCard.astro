---
import type { CollectionEntry } from 'astro:content';
import Monogram from './Monogram.astro';
import { CATEGORIES } from '../lib/site';
interface Props { tool: CollectionEntry<'tools'>; pick?: boolean }
const { tool, pick = false } = Astro.props;
const t = tool.data;
---
<li class="card" data-name={`${t.name} ${t.vendor} ${t.bestFor} ${t.summary}`.toLowerCase()} data-category={t.category}>
  <div class="top">
    <Monogram name={t.name} color={t.color} size={60} />
    {pick && <span class="pick"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1.8l2.5 5.1 5.6.8-4 3.9.9 5.6-5-2.6-5 2.6.9-5.6-4-3.9 5.6-.8z" fill="currentColor"/></svg>Top pick</span>}
  </div>
  <span class="cat">{CATEGORIES[t.category].label}</span>
  <h3><a href={`/tools/${tool.id}/`}>{t.name}</a></h3>
  <p>{t.summary}</p>
  <div class="foot">
    <span class="price">{t.pricing}</span>
    <span class="more" aria-hidden="true">Details <svg viewBox="0 0 20 20"><path d="M4 10h11m-4-4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
  </div>
</li>
<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 22px;
    padding: 28px 28px 22px;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .card:hover,
  .card:focus-within {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--cobalt) 35%, var(--rule));
    box-shadow: 0 18px 40px -18px color-mix(in srgb, var(--ink) 30%, transparent);
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 22px;
  }
  .top :global(.mono) {
    border-radius: 16px;
  }
  .pick {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font: 700 0.85rem var(--display);
    padding: 5px 11px;
    border-radius: 999px;
    background: #fff6d6;
    color: #6b4e00;
  }
  .pick svg {
    width: 15px;
    height: 15px;
    color: #f2b705;
  }
  .cat {
    font: 700 0.78rem var(--display);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cobalt);
  }
  h3 {
    margin: 8px 0 10px;
    font-size: 1.55rem;
    letter-spacing: -0.03em;
  }
  h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 22px;
  }
  p {
    margin: 0 0 20px;
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--ink-soft);
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 16px;
    border-top: 1px solid var(--rule);
    font-family: var(--display);
  }
  .price {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    color: var(--ink);
    transition: color 0.15s;
  }
  .more svg {
    width: 18px;
    height: 18px;
    transition: transform 0.15s;
  }
  .card:hover .more {
    color: var(--cobalt);
  }
  .card:hover .more svg {
    transform: translateX(3px);
  }
  :root[data-theme='dark'] .pick { background: #3a3010; color: #f5d77a; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .pick { background: #3a3010; color: #f5d77a; }
  }
</style>
