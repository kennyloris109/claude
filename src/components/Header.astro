---
import { SITE } from '../site.config.mjs';
const nav = [
  { href: '/tools/', label: 'All tools' },
  { href: '/categories/', label: 'Categories' },
  { href: '/methodology/', label: 'How we compare' },
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="bar">
    <a class="brand" href="/" aria-label={`${SITE.name} home`}>
      <svg class="mark" viewBox="0 0 32 32" aria-hidden="true">
        <rect x="1" y="1" width="30" height="30" rx="9" fill="currentColor" />
        <path d="M9 16.5l4.5 4.5L23 11.5" fill="none" stroke="#fff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      {SITE.name}
    </a>
    <nav aria-label="Main">
      <ul>
        {nav.map((n) => (
          <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="btn btn-primary cta" href="/compare/" aria-current={path.startsWith('/compare/') ? 'page' : undefined}>Comparisons</a>
  </div>
</header>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--paper-raised) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    max-width: 1240px;
    margin-inline: auto;
    padding: 14px var(--gutter);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
  }
  .brand {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 800 1.4rem var(--display);
    letter-spacing: -0.035em;
    color: var(--cobalt);
    text-decoration: none;
  }
  .mark {
    width: 32px;
    height: 32px;
    color: var(--cobalt);
  }
  ul {
    display: flex;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: block;
    padding: 8px 14px;
    border-radius: 10px;
    font: 500 1rem var(--display);
    color: var(--ink-soft);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--ink);
    background: var(--tint);
  }
  nav a[aria-current='page'] {
    color: var(--cobalt);
    font-weight: 700;
  }
  .cta {
    justify-self: end;
    padding: 10px 18px;
    font-size: 0.95rem;
    border-radius: 999px;
  }
  @media (max-width: 860px) {
    .bar {
      grid-template-columns: 1fr auto;
    }
    nav {
      grid-column: 1 / -1;
      grid-row: 2;
      overflow-x: auto;
    }
    ul {
      gap: 2px;
    }
    nav a {
      padding: 6px 10px;
      font-size: 0.95rem;
      white-space: nowrap;
    }
  }
</style>
