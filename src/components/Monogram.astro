---
interface Props { name: string; color: string; size?: number }
const { name, color, size = 56 } = Astro.props;
// Two-word names use initials (GitHub Copilot → GC); one-word names use two letters (Claude → Cl).
const words = name.replace(/\.[a-z]+$/i, '').replace(/[^A-Za-z ]/g, '').split(' ').filter(Boolean);
const letters = words.length > 1 ? words.slice(0, 2).map((w) => w[0]).join('') : words[0].slice(0, 2);
---
<span class="mono" style={`--c:${color};--s:${size}px`} aria-hidden="true">{letters}</span>
<style>
  .mono {
    display: inline-grid;
    place-items: center;
    width: var(--s);
    height: var(--s);
    border-radius: 30%;
    background: var(--c);
    color: #fff;
    font-family: var(--display);
    font-weight: 800;
    font-size: calc(var(--s) * 0.4);
    letter-spacing: -0.04em;
    flex: none;
  }
</style>
